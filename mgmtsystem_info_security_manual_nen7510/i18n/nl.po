#. module: mgmtsystem_info_security_manual_nen7510
#: model_terms:ir.ui.view,arch_db:mgmtsystem_info_security_manual_nen7510.view_risk_canvas
#, fuzzy
msgid ""
"<strong>Inkomstenstromen.</strong>\n"
"                                <br/>\n"
"                                Om als bedrijf levensvatbaar te zijn moet het voldoende inkomsten "
"genereren. De\n"
"                                inkomsten die een bedrijf genereert moeten hoog genoeg zijn om de kosten te "
"dekken en\n"
"                                onder aan de streep een mooi bedrijfsresultaat(winst) over te houden. Een "
"bedrijf zonder\n"
"                                goed verdienmodel is gedoemd te falen! De kassa moet rinkelen, want een "
"druppelende\n"
"                                geldkraan is niet genoeg om te overleven."
msgstr ""
"<strong>Inkomstenstromen.</strong>\n"
"                               <br/>\n"
"                                Om als bedrijf levensvatbaar te zijn moet het voldoende inkomsten "
"genereren. De\n"
"                                inkomsten die een bedrijf genereert moeten hoog genoeg zijn om de kosten te "
"dekken en\n"
"                                onder aan de streep een mooi bedrijfsresultaat(winst) over te houden. Een "
"bedrijf zonder\n"
"                                goed verdienmodel is gedoemd te mislukken! De kassa moet rinkelen, want een "
"druppelende\n"
"                                geldkraan is niet genoeg om te overleven."

#. module: mgmtsystem_info_security_manual_nen7510
#: model_terms:ir.ui.view,arch_db:mgmtsystem_info_security_manual_nen7510.view_risk_canvas
#, fuzzy
msgid ""
"<strong>Kanalen.</strong>\n"
"                                <br/>\n"
"                                Met kanalen worden al de manieren waarmee een organisatie in contact staat "
"met de klant\n"
"                                bedoeld. Het vinden van de juiste mix van kanalen is cruciaal om klanten "
"met de\n"
"                                waardepropositie te bereiken. In de bouwsteen kanalen beschrijf je hoe je "
"bedrijf met de\n"
"                                verschillende klanten communiceert en hoe je deze klanten met de "
"waardepropositie\n"
"                                bereikt. De manieren hoe men in contact staat met de klant kunnen op "
"diverse manieren\n"
"                                onderverdeeld worden. Zo is er onderscheidt te maken in communicatie-, "
"distributie- en\n"
"                                verkoopkanalen. Ook kan er onderscheidt gemaakt worden tussen online- en "
"fysieke\n"
"                                kanalen."
msgstr ""
"<strong>Kanalen.</strong>\n"
"                               <br/>\n"
"                                Met kanalen worden alle manieren waarmee een organisatie in contact staat "
"met de klant\n"
"                                bedoeld. Het vinden van de juiste mix van kanalen is cruciaal om klanten "
"met de\n"
"                                waardepropositie te bereiken. In de bouwsteen kanalen beschrijf je hoe je "
"bedrijf met de\n"
"                                verschillende klanten communiceert en hoe je deze klanten met de "
"waardepropositie\n"
"                                bereikt. De manieren waarop men in contact staat met de klant kunnen op "
"diverse manieren\n"
"                                onderverdeeld worden. Zo is er onderscheidt te maken in communicatie-, "
"distributie- en\n"
"                                verkoopkanalen. Ook kan er onderscheidt gemaakt worden tussen online- en "
"fysieke\n"
"                                kanalen."

#. module: mgmtsystem_info_security_manual_nen7510
#: model_terms:ir.ui.view,arch_db:mgmtsystem_info_security_manual_nen7510.view_risk_canvas
#, fuzzy
msgid ""
"<strong>Kern (strategische) partners.</strong>\n"
"                                <br/>\n"
"                                De bouwsteen kern partners gaat over het netwerk van leveranciers en "
"partners die nodig\n"
"                                zijn om het businessmodel te laten werken. Bedrijven gaan om allerlei "
"redenen\n"
"                                partnerschappen aan. Het creëren van het juiste netwerk kan als een "
"belangrijke factor\n"
"                                voor succesvol ondernemerschap gezien worden. Een oude wijsheid luidt niet "
"voor niks:\n"
"                                ”Het geheel is meer dan de som der delen”. Partners kunnen een organisatie "
"helpen om\n"
"                                dingen te doen die alleen niet mogelijk zijn. De juiste partnerships helpen "
"om succesvol\n"
"                                te zijn, te groeien en te concurreren"
msgstr ""
"<strong>Kern (strategische) partners.</strong>\n"
"                               <br/>\n"
"                                De bouwsteen kernpartners gaat over het netwerk van leveranciers en "
"partners die nodig\n"
"                                zijn om het businessmodel te laten werken. Bedrijven gaan om allerlei "
"redenen\n"
"                                partnerschappen aan. Het creëren van het juiste netwerk kan als een "
"belangrijke factor\n"
"                                voor succesvol ondernemerschap gezien worden. Een oude wijsheid luidt niet "
"voor niks:\n"
"                                \"Het geheel is meer dan de som der delen\". Partners kunnen een "
"organisatie helpen om\n"
"                                dingen te doen die alleen niet mogelijk zijn. De juiste partnerships helpen "
"om succesvol\n"
"                                te zijn, te groeien en te concurreren"

#. module: mgmtsystem_info_security_manual_nen7510
#: model_terms:ir.ui.view,arch_db:mgmtsystem_info_security_manual_nen7510.view_risk_canvas
#, fuzzy
msgid ""
"<strong>Kernmiddelen.</strong>\n"
"                                <br/>\n"
"                                De key resources Business Model Canvas bouwsteen beschrijft de "
"belangrijkste middelen\n"
"                                die nodig zijn om de waardepropositie te kunnen realiseren en het "
"businessmodel te laten\n"
"                                werken. Key resources kunnen in eigendom zijn van het bedrijf, maar kunnen "
"ook geleased\n"
"                                worden of bij key partners verkregen worden. Key resources kunnen in de "
"volgende\n"
"                                categorieën worden ingedeeld: fysiek, financieel, intellectueel en "
"menselijk (human\n"
"                                resources)."
msgstr ""
"<strong>Kernmiddelen.</strong>\n"
"                               <br/>\n"
"                                De belangrijkste middelen Business Model Canvas bouwsteen beschrijft de "
"belangrijkste middelen\n"
"                                die nodig zijn om de waardepropositie te kunnen realiseren en het "
"businessmodel te laten\n"
"                                werken. Key resources kunnen in eigendom zijn van het bedrijf, maar kunnen "
"ook geleased\n"
"                                worden of bij belangrijke partners verkregen worden. Key resources kunnen "
"in de volgende\n"
"                                categorieën worden ingedeeld: fysiek, financieel, intellectueel en "
"menselijk (human\n"
"                                middelen)."

#. module: mgmtsystem_info_security_manual_nen7510
#: model_terms:ir.ui.view,arch_db:mgmtsystem_info_security_manual_nen7510.view_risk_canvas
#, fuzzy
msgid ""
"<strong>Kernprocessen.</strong>\n"
"                                <br/>\n"
"                                In de bouwsteen kernactiviteiten worden de belangrijkste activiteiten "
"beschreven die een\n"
"                                onderneming nodig heeft om goed te presteren. Het gaat dus om de "
"kernactiviteiten die de\n"
"                                organisatie moet uitvoeren om de waardepropositie te realiseren, klanten te "
"bereiken,\n"
"                                klantrelaties te onderhouden en inkomsten te verdienen. Welke activiteiten "
"dit zijn\n"
"                                hangt compleet af van de inrichting van het businessmodel."
msgstr ""
"<strong>Kernprocessen.</strong>\n"
"                               <br/>\n"
"                                In de bouwsteen kernactiviteiten worden de belangrijkste activiteiten "
"beschreven die een\n"
"                                onderneming nodig heeft om goed te presteren. Het gaat dus om de "
"kernactiviteiten die de\n"
"                                organisatie moet uitvoeren om de waardepropositie te realiseren, klanten te "
"bereiken,\n"
"                                klantrelaties te onderhouden en inkomsten te verdienen. Welke activiteiten "
"dit zijn\n"
"                                hangt compleet af van de inrichting van het businessmodel."

#. module: mgmtsystem_info_security_manual_nen7510
#: model_terms:ir.ui.view,arch_db:mgmtsystem_info_security_manual_nen7510.view_risk_canvas
#, fuzzy
msgid ""
"<strong>Klantrelaties.</strong>\n"
"                                <br/>\n"
"                                In de bouwsteen ”klantrelaties” wordt er beschreven hoe de onderneming in "
"contact staat\n"
"                                met de klant en hoe relaties opgebouwd en onderhouden worden met ieder "
"klantsegment. Er\n"
"                                zijn verschillende type relaties die men aan kan gaan met klanten. Voor een "
"onderneming\n"
"                                is het belangrijk om te motiveren waarom men een bepaalde relatie aan wil "
"gaan met een\n"
"                                klantsegment. De keuze van het type klantrelatie heeft namelijk invloed op "
"alles wat een\n"
"                                bedrijf doet en beïnvloedt ook de andere bouwstenen in het Business Model "
"Canvas. Er\n"
"                                zijn de volgende soorten klantrelaties te onderscheiden: Persoonlijke "
"relatie, digitale\n"
"                                relatie, community, co-creatie en zelfservice."
msgstr ""
"<strong>Klantrelaties.</strong>\n"
"                               <br/>\n"
"                                In de bouwsteen \"klantrelaties\" wordt er beschreven hoe de onderneming in "
"contact staat\n"
"                                met de klant en hoe relaties opgebouwd en onderhouden worden met ieder "
"klantsegment. Er\n"
"                                zijn verschillende type relaties die men aan kan gaan met klanten. Voor een "
"onderneming\n"
"                                is het belangrijk om te motiveren waarom men een bepaalde relatie aan wil "
"gaan met een\n"
"                                klantsegment. De keuze van het type klantrelatie heeft namelijk invloed op "
"alles wat een\n"
"                                bedrijf doet en beïnvloedt ook de andere bouwstenen in het Business Model "
"Canvas. Er\n"
"                                zijn de volgende soorten klantrelaties te onderscheiden: Persoonlijke "
"relatie, digitale\n"
"                                relatie, community, co-creatie en zelfservice."

#. module: mgmtsystem_info_security_manual_nen7510
#: model_terms:ir.ui.view,arch_db:mgmtsystem_info_security_manual_nen7510.view_risk_canvas
#, fuzzy
msgid ""
"<strong>Klantsegmenten.</strong>\n"
"                                <br/>\n"
"                                Wie zijn je klanten? De meeste bedrijven richten zich op een deel van de "
"markt; op één\n"
"                                of meerdere segmenten.\n"
"                                Waarde propositie\n"
"                                De ”Waardeproposities” vormt de kern van je bedrijf. Richt je op de waarde "
"die je voor\n"
"                                je klanten creëert, de belofte aan je klanten; dat is meer dan een "
"opsomming van\n"
"                                producten. Wat is de kern van je product aanbod, welke elementen zijn uniek."
msgstr ""
"<strong>Klantsegmenten.</strong>\n"
"                               <br/>\n"
"                                Wie zijn je klanten? De meeste bedrijven richten zich op een deel van de "
"markt; op één\n"
"                                of meerdere segmenten.\n"
"                                Waarde propositie\n"
"                                De \"Waardeproposities\" vormt de kern van je bedrijf. Richt je op de "
"waarde die je voor\n"
"                                je klanten creëert, de belofte aan je klanten; dat is meer dan een "
"opsomming van\n"
"                                producten. Wat is de kern van je productaanbod, welke elementen zijn uniek."

#. module: mgmtsystem_info_security_manual_nen7510
#: model_terms:ir.ui.view,arch_db:mgmtsystem_info_security_manual_nen7510.view_risk_canvas
#, fuzzy
msgid ""
"<strong>Kostenstructuur.</strong>\n"
"                                <br/>\n"
"                                De bouwsteen kostenstructuur beschrijft al de belangrijke kosten die "
"gemaakt worden bij\n"
"                                het uitvoeren van een businessmodel. Kosten zijn onvermijdbaar! Het creëren "
"van waarde,\n"
"                                het onderhouden van klantrelaties en het genereren van inkomsten brengen "
"allemaal kosten\n"
"                                met zich mee. Zoals vanzelfsprekend is het belangrijk om de kosten binnen "
"de perken te\n"
"                                houden en te focussen op zaken die daadwerkelijk waarde toevoegen voor "
"klanten. Voor het\n"
"                                ene businessmodel is kostenreductie één van de belangrijkste zaken, terwijl "
"dit in\n"
"                                andere businessmodellen minder belangrijk is."
msgstr ""
"<strong>Kostenstructuur.</strong>\n"
"                               <br/>\n"
"                                De bouwsteen kostenstructuur beschrijft al de belangrijke kosten die "
"gemaakt worden bij\n"
"                                het uitvoeren van een businessmodel. Kosten zijn onvermijdbaar! Het creëren "
"van waarde,\n"
"                                het onderhouden van klantrelaties en het genereren van inkomsten brengen "
"allemaal kosten\n"
"                                met zich mee. Zoals vanzelfsprekend is het belangrijk om de kosten binnen "
"de perken te\n"
"                                houden en te focussen op zaken die daadwerkelijk waarde toevoegen voor "
"klanten. Voor het\n"
"                                ene businessmodel is kostenreductie één van de belangrijkste zaken, terwijl "
"dit in\n"
"                                andere businessmodellen minder belangrijk is."

