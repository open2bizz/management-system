<?xml version="1.0" encoding="utf-8" ?>
<odoo>

        <record id="view_mgmtsystem_nonconformity_form" model="ir.ui.view">
            <field name="name">view_mgmtsystem_nonconformity_form_nen7510</field>
            <field name="model">mgmtsystem.nonconformity</field>
            <field name="inherit_id" ref="mgmtsystem_nonconformity.view_mgmtsystem_nonconformity_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page name="root_cause_analysis" string="Root Cause Analysis">
                        <group>
                            <field name="root_cause_analysis"/>
                            <field name="root_cause_analysis_id" readonly="1"/>
                        </group>
                        <div invisible="root_cause_analysis_id">
                            <button
                                name="action_create_root_cause_analysis"
                                string="Create Root Cause Analysis"
                                type="object"
                                class="btn-primary"
                                invisible="not root_cause_analysis"
                            />
                        </div>
                    </page>
                </xpath>
            </field>
        </record>

</odoo>
