<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

        <!-- type -->

        <record id="type_information" model="mgmtsystem.hazard.type">
            <field name="name">Information Risk</field>
            <field name="description">Valt onder informatie Risico</field>
        </record>
        <record id="type_other" model="mgmtsystem.hazard.type">
            <field name="name">NO Information Risk</field>
            <field name="description">Valt NIET onder informatie Risico</field>
        </record>


        <record id="risk_type_information" model="mgmtsystem.hazard.risk.type">
            <field name="name">Information Risk</field>
            <field name="description">Valt onder informatie Risico</field>
        </record>
        <record id="risk_type_other" model="mgmtsystem.hazard.risk.type">
            <field name="name">Other Risk</field>
            <field name="description">Valt NIET onder informatie Risico</field>
        </record>

        <record id="probability_low" model="mgmtsystem.hazard.probability">
            <field name="name">Low</field>
            <field name="value">0</field>
            <field name="description">Lage waarschijnlijkheid</field>
        </record>
        <record id="probability_med" model="mgmtsystem.hazard.probability">
            <field name="name">Medium</field>
            <field name="value">1</field>
            <field name="description">Medium waarschijnlijkheid</field>
        </record>
        <record id="probability_high" model="mgmtsystem.hazard.probability">
            <field name="name">Hoog</field>
            <field name="value">3</field>
            <field name="description">Hoge waarschijnlijkheid</field>
        </record>

        <record id="severity_low" model="mgmtsystem.hazard.severity">
            <field name="name">Low</field>
            <field name="value">0</field>
            <field name="description">Lage impact</field>
        </record>
        <record id="severity_med" model="mgmtsystem.hazard.severity">
            <field name="name">Medium</field>
            <field name="value">1</field>
            <field name="description">Medium impact</field>
        </record>
        <record id="severity_high" model="mgmtsystem.hazard.severity">
            <field name="name">Hoog</field>
            <field name="value">3</field>
            <field name="description">Hoge impact</field>
        </record>

</odoo>
